{
  "venue": "bullet",
  "env_files": [
    ".env.bullet.local"
  ],
  "benchmark": {
    "scenario": "single",
    "iterations": 10,
    "warmups": 2,
    "batch_size": 1,
    "rate_per_second": 0,
    "max_in_flight": 1,
    "latency_mode": "total",
    "measurement_mode": "ws_confirmation",
    "confirmation_timeout_ms": 10000
  },
  "http": {
    "timeout_ms": 10000,
    "max_idle_conns": 16,
    "max_idle_conns_per_host": 8,
    "disable_compression": true
  },
  "risk": {
    "require_post_only": true
  },
  "cleanup": {
    "enabled": true,
    "mode": "best_effort",
    "scope": "after_sample",
    "timeout_ms": 15000
  },
  "request": {
    "transport": "websocket",
    "builder": {
      "type": "persistent_command",
      "command": [
        "node",
        "internal/venues/bullet/build_payload.mjs"
      ],
      "timeout_ms": 20000,
      "params": {
        "network": "testnet",
        "symbol": "BTC-USD",
        "side": "bid",
        "size": "0.0001",
        "price": "50000",
        "order_type": "post_only",
        "post_only_price_source": "book_top",
        "post_only_price_offset_bps": 25,
        "post_only_book_max_age_ms": 120000
      }
    },
    "ws_url": "wss://tradingapi.testnet.bullet.xyz/ws"
  }
}
