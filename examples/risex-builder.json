{
  "venue": "risex",
  "env_files": [
    ".env.risex.local"
  ],
  "benchmark": {
    "scenario": "single",
    "iterations": 10,
    "warmups": 2,
    "batch_size": 1,
    "rate_per_second": 0,
    "max_in_flight": 1,
    "latency_mode": "total",
    "measurement_mode": "ws_confirmation",
    "confirmation_timeout_ms": 10000
  },
  "http": {
    "timeout_ms": 10000,
    "max_idle_conns": 16,
    "max_idle_conns_per_host": 8,
    "disable_compression": false
  },
  "risk": {
    "require_post_only": true
  },
  "cleanup": {
    "enabled": true,
    "mode": "best_effort",
    "scope": "after_sample",
    "timeout_ms": 15000
  },
  "request": {
    "transport": "http",
    "builder": {
      "type": "persistent_command",
      "command": [
        "uv",
        "run",
        "--python",
        "3.13",
        "--with",
        "eth-account",
        "--with",
        "eth-utils",
        "python",
        "internal/venues/risex/build_payload.py"
      ],
      "timeout_ms": 5000,
      "params": {
        "market_id": 1,
        "symbol": "BTC/USDC",
        "side": "buy",
        "amount": "0.001",
        "price": "60000",
        "order_type": "limit",
        "time_in_force": "gtc",
        "post_only": true,
        "confirmation": true,
        "cancel_confirmation": true
      }
    }
  }
}
