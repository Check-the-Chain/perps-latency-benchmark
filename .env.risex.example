# Copy to .env.risex.local and fill locally. Do not commit local env files.

# EVM private key for the main RISEx account that holds collateral. This
# account must be deposited/registered on RISE mainnet (chain ID 4153) before
# it can place orders. Set this OR RISEX_ACCOUNT_ADDRESS below, not both --
# see the note there for when to use the address-only form.
RISEX_PRIVATE_KEY=

# Alternative to RISEX_PRIVATE_KEY: the main account's address only, with no
# private key. Order/cancel placement only ever needs this address (the
# session signer does all the EIP-712 signing); RISEX_PRIVATE_KEY is only
# needed for register_signer.py's one-time on-chain registration step. If
# your main account is a hardware wallet, or RISEx's own website UI already
# registered your signer (a flow that has you sign with your main wallet
# directly, e.g. "Create API Wallet"), you never need to export the main
# account's raw key -- set RISEX_ACCOUNT_ADDRESS instead and leave
# RISEX_PRIVATE_KEY blank.
RISEX_ACCOUNT_ADDRESS=

# EVM private key for the RISEx *session signer* key (RISEx's UI may call
# this an "API wallet"). This must be a different key from RISEX_PRIVATE_KEY,
# generated separately and registered via POST /v1/auth/register-signer (two
# EIP-712 signatures: RegisterSigner from the account, VerifySigner from the
# signer) -- either through internal/venues/risex/register_signer.py or
# RISEx's own website UI. See internal/venues/risex/README.md for the
# registration flow.
RISEX_SIGNER_PRIVATE_KEY=

# Optional overrides. RISEx's docs are inconsistent about mainnet hostnames
# and never state a mainnet REST base URL; the defaults below were confirmed
# live (chain_id 4153, matching router/auth addresses from
# GET /v1/system/config) at implementation time but should be re-verified
# before a live run.
RISEX_BASE_URL=https://api.rise.trade

# Optional: pin a starting nonce_anchor instead of fetching one from
# GET /v1/nonce-state/{account}. Leave unset unless you know why you need it.
RISEX_NONCE_ANCHOR=
